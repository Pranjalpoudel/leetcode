from sortedcontainers import SortedList

class Solution:
    def minimumCost(self, nums: List[int], k: int, dist: int) -> int:
        n = len(nums)
        # We only need k - 1 values from indices [1..]
        need = k - 1

        # Initial window from 1 to dist+1 (inclusive, if exists)
        window_sum = 0
        selected = SortedList()
        candidates = SortedList()
        
        # Build initial window (only indices 1..dist+1)
        for i in range(1, min(n, dist + 2)):
            window_sum += nums[i]
            selected.add(nums[i])

        # Balance function to keep top `need` smallest in selected
        def balance():
            nonlocal window_sum
            # If we need more, pull from candidates
            while len(selected) < need and candidates:
                x = candidates.pop(0)
                selected.add(x)
                window_sum += x
            # If too many, push back to candidates
            while len(selected) > need:
                x = selected.pop(-1)
                candidates.add(x)
                window_sum -= x

        balance()
        # Initial best
        min_sum = window_sum

        # Slide window
        for i in range(dist + 2, n):
            out_val = nums[i - (dist + 1)]
            # Remove outgoing element from selected or candidates
            if out_val in selected:
                selected.remove(out_val)
                window_sum -= out_val
            else:
                candidates.remove(out_val)

            # Add new incoming
            new_val = nums[i]
            if selected and new_val < selected[-1]:
                selected.add(new_val)
                window_sum += new_val
            else:
                candidates.add(new_val)

            balance()
            min_sum = min(min_sum, window_sum)

        # Always include nums[0]
        return nums[0] + min_sum
